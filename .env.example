# user-токен с доступом к messages.* (например, через https://vkhost.github.io/); ACCESS_TOKEN тоже принимается
VK_TOKEN=
# ещё аккаунты через запятую — у каждого свой владелец и свои настройки (state/<id>.json)
# VK_TOKENS=
# доверенные всех аккаунтов: числовые ID через запятую, добавляются при каждом старте
# TRUSTED_IDS=

# писать в лог все входящие сообщения (имя беседы, автор, текст) — по умолчанию выключено
# LOG_MESSAGES=false
# сколько сообщений обрабатывается одновременно
# WORKERS=8
